          </div>
          <div>
            <label class="block text-[11px] font-bold text-[#524149] uppercase tracking-wider mb-1">Telefone / WhatsApp *</label>
            <input type="tel" name="customerPhone" required placeholder="+258 84..." class="w-full px-3.5 py-2.5 rounded-xl border border-[#F0DEE7] focus:border-[#FF70B0] outline-none text-xs bg-[#FAF7F9] focus:bg-white text-[#181114]">
          </div>
        </div>

        <div>
          <label for="cateringEventType" class="block text-[11px] font-bold text-[#524149] uppercase tracking-wider mb-1">Tipo de Serviço *</label>
