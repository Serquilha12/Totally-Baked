            <option value="Catering Corporativo / Coffee-Break">Catering Corporativo / Coffee-Break</option>
            <option value="Casamento / Baptizado / Evento Privado">Casamento / Baptizado / Evento Privado</option>
            <option value="Almoços Executivos para Grupos">Almoços Executivos para Grupos / Empresas</option>
            <option value="Mesa de Doces & Salgados Artesanais">Mesa de Doces & Salgados Artesanais</option>
          </select>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-[11px] font-bold text-[#524149] uppercase tracking-wider mb-1">Data Prevista</label>
            <input type="date" name="eventDate" class="w-full px-3.5 py-2.5 rounded-xl border border-[#F0DEE7] focus:border-[#FF70B0] outline-none text-xs bg-[#FAF7F9] focus:bg-white text-[#181114]">
          </div>
          <div>
            <label class="block text-[11px] font-bold text-[#524149] uppercase tracking-wider mb-1">Nº de Convidados / Peso</label>
