          </div>
        </div>

        <div>
          <label class="block text-[11px] font-bold text-[#524149] uppercase tracking-wider mb-1">Sabores, Tema ou Pedido Especial</label>
          <textarea name="details" rows="3" placeholder="Conte-nos os sabores preferidos, horário pretendido, local em Pemba ou inscrição no bolo..." class="w-full px-3.5 py-2.5 rounded-xl border border-[#F0DEE7] focus:border-[#FF70B0] outline-none text-xs bg-[#FAF7F9] focus:bg-white text-[#181114]"></textarea>
        </div>

        <button type="submit" class="btn-rose-glow w-full min-h-[48px] py-3.5 text-xs sm:text-sm font-semibold flex items-center justify-center gap-2">
          <i class="fa-brands fa-whatsapp text-base"></i>
          <span>Solicitar Orçamento no WhatsApp Oficial</span>
        </button>
      </form>
    </div>
