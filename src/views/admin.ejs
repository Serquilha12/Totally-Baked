<%- include('partials/header') %>

<div class="bg-gradient-to-b from-[#FFECF5]/70 to-white text-[#1E1218] py-10 border-b border-[#FFC4DE]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-[#FFC4DE] mb-2 shadow-sm">
          <span class="font-feline text-lg text-[#FF70B0] leading-none">Feline</span>
          <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#4A3540]">• Consola Operacional</span>
        </div>
        <h1 class="font-moret text-3xl sm:text-4xl font-extrabold text-[#1E1218]">
          Totally Baked • Gestão do Atelier & Despacho
        </h1>
        <p class="text-xs text-[#4A3540] mt-1 font-normal">
          Monitorização de encomendas em tempo real, despacho telemétrico com GPS e controle de stock em Pemba.
        </p>
      </div>

      <!-- Alerta Sonoro & Ações de Teste -->
      <div class="flex items-center gap-3">
        <button id="toggleAudioBtn" class="px-4 py-2 rounded-full bg-white hover:bg-[#FFECF5] text-xs text-[#1E1218] font-semibold flex items-center gap-2 transition-all border border-[#FFC4DE] shadow-sm">
          <i id="audioIcon" class="fa-solid fa-bell text-[#FF70B0] text-[11px]"></i>
          <span id="audioStatusText">Chime: Ligado</span>
        </button>

        <button onclick="window.Admin.playAlert()" class="px-4 py-2 rounded-full btn-rose-glow text-white text-xs font-bold flex items-center gap-1.5">
          <i class="fa-solid fa-volume-high text-[11px]"></i>
          <span>Testar Sinal</span>
        </button>
      </div>
    </div>

    <!-- Indicadores Chave de Desempenho (KPIs em Cartões Brancos) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-8">
      <div class="bg-white border border-[#FFC4DE] rounded-2xl p-4 shadow-sm">
        <span class="text-[10px] uppercase tracking-wider text-[#7D6570] block font-bold">Faturamento Diário</span>
        <span class="font-moret text-2xl font-extrabold text-[#1E1218] mt-1 block"><%= stats.totalRevenue %> <span class="text-xs font-sans text-[#FF70B0] font-bold">MZN</span></span>
        <span class="text-[10px] text-emerald-600 font-semibold mt-1 block"><%= stats.deliveredOrders %> encomendas concluídas</span>
      </div>

      <div class="bg-white border border-[#FFC4DE] rounded-2xl p-4 shadow-sm">
        <span class="text-[10px] uppercase tracking-wider text-[#7D6570] block font-bold">Total de Pedidos</span>
        <span class="font-moret text-2xl font-extrabold text-[#1E1218] mt-1 block"><%= stats.totalOrders %></span>
        <span class="text-[10px] text-[#7D6570] mt-1 block">Registados hoje</span>
      </div>

      <div class="bg-white border border-[#FFC4DE] rounded-2xl p-4 shadow-sm">
        <span class="text-[10px] uppercase tracking-wider text-[#7D6570] block font-bold">Em Produção / Rota</span>
        <span class="font-moret text-2xl font-extrabold text-[#FF70B0] mt-1 block"><%= stats.activeOrders %></span>
        <span class="text-[10px] text-[#4A3540] font-medium mt-1 block">Requerem atenção</span>
      </div>

      <div class="bg-white border border-[#FFC4DE] rounded-2xl p-4 shadow-sm">
        <span class="text-[10px] uppercase tracking-wider text-[#7D6570] block font-bold">Disponibilidade da Carta</span>
        <span class="font-moret text-2xl font-extrabold text-[#1E1218] mt-1 block"><%= products.filter(p => p.isAvailable).length %> / <%= products.length %></span>
        <span class="text-[10px] text-[#7D6570] mt-1 block">Itens ativos</span>
      </div>
    </div>

  </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
  
  <!-- Seção 1: Kanban de Pedidos em Tempo Real -->
  <section>
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="font-serif text-2xl font-normal text-brand-dark">Fluxo Operacional de Encomendas</h2>
        <p class="text-xs text-brand-muted font-light">Progresso sequencial desde a entrada do pedido até a entrega final.</p>
      </div>

      <span class="text-[11px] text-emerald-800 bg-emerald-50 px-3 py-1 rounded-md border border-emerald-200 font-mono flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
        Sincronização Ativa (5s)
      </span>
    </div>

    <!-- 4 Colunas do Kanban -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
      
      <!-- Coluna: 1. Pendentes -->
      <div class="bg-brand-surface rounded-xl p-4 border border-brand-dark/10 flex flex-col">
        <div class="flex items-center justify-between pb-3 mb-3 border-b border-brand-dark/5">
          <span class="text-xs font-semibold uppercase tracking-wider text-brand-dark flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#FF70B0]"></span>
            Recebido (<%= kanban.pending.length %>)
          </span>
          <span class="text-[9px] uppercase tracking-wider text-stone-500 font-mono">Fase 1</span>
        </div>

        <div class="space-y-3 flex-grow overflow-y-auto max-h-[500px]">
          <% if (kanban.pending.length === 0) { %>
            <p class="text-xs text-stone-400 text-center py-8 font-light">Sem pedidos pendentes.</p>
          <% } %>
          <% kanban.pending.forEach(order => { %>
            <div class="bg-brand-surfaceSoft rounded-lg p-3.5 border border-brand-dark/10 text-xs">
              <div class="flex justify-between items-start">
                <span class="font-mono text-[11px] font-bold text-brand-accent">#<%= order.id %></span>
                <span class="text-[10px] text-stone-400"><%= new Date(order.createdAt).toLocaleTimeString('pt-MZ', { hour: '2-digit', minute: '2-digit' }) %></span>
              </div>
              <h4 class="font-medium text-brand-dark mt-1"><%= order.customerName %></h4>
              <p class="text-[11px] text-brand-muted"><%= order.neighborhood %></p>
              
              <div class="mt-2 text-[11px] text-stone-600 font-light border-t border-brand-dark/5 pt-1.5">
                <%= order.items.map(i => `${i.quantity}x ${i.name}`).join(', ') %>
              </div>

              <div class="mt-3 pt-2 border-t border-brand-dark/5 flex items-center justify-between">
                <span class="font-serif text-xs text-brand-dark"><%= order.total %> MZN</span>
                <button onclick="window.Admin.updateStatus('<%= order.id %>', 'preparing')" class="px-2.5 py-1 rounded bg-brand-dark hover:bg-brand-accent text-white text-[10px] uppercase tracking-wider transition-colors">
                  Preparar &rarr;
                </button>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Coluna: 2. Preparando -->
      <div class="bg-brand-surface rounded-xl p-4 border border-brand-dark/10 flex flex-col">
        <div class="flex items-center justify-between pb-3 mb-3 border-b border-brand-dark/5">
          <span class="text-xs font-semibold uppercase tracking-wider text-brand-dark flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-blue-600"></span>
            Em Forno (<%= kanban.preparing.length %>)
          </span>
          <span class="text-[9px] uppercase tracking-wider text-stone-500 font-mono">Fase 2</span>
        </div>

        <div class="space-y-3 flex-grow overflow-y-auto max-h-[500px]">
          <% if (kanban.preparing.length === 0) { %>
            <p class="text-xs text-stone-400 text-center py-8 font-light">Nenhum item em forno.</p>
          <% } %>
          <% kanban.preparing.forEach(order => { %>
            <div class="bg-brand-surfaceSoft rounded-lg p-3.5 border border-brand-dark/10 text-xs">
              <div class="flex justify-between items-start">
                <span class="font-mono text-[11px] font-bold text-blue-700">#<%= order.id %></span>
                <span class="text-[10px] text-stone-400"><%= new Date(order.createdAt).toLocaleTimeString('pt-MZ', { hour: '2-digit', minute: '2-digit' }) %></span>
              </div>
              <h4 class="font-medium text-brand-dark mt-1"><%= order.customerName %></h4>
              <p class="text-[11px] text-brand-muted"><%= order.neighborhood %></p>
              
              <div class="mt-2 text-[11px] text-stone-600 font-light border-t border-brand-dark/5 pt-1.5">
                <%= order.items.map(i => `${i.quantity}x ${i.name}`).join(', ') %>
              </div>

              <div class="mt-3 pt-2 border-t border-brand-dark/5 flex items-center justify-between">
                <span class="font-serif text-xs text-brand-dark"><%= order.total %> MZN</span>
                <button onclick="window.Admin.updateStatus('<%= order.id %>', 'in_transit')" class="px-2.5 py-1 rounded bg-brand-accent hover:bg-brand-accentHover text-white text-[10px] uppercase tracking-wider transition-colors">
                  Despachar GPS
                </button>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Coluna: 3. Em Rota -->
      <div class="bg-brand-surface rounded-xl p-4 border border-brand-accent/30 flex flex-col">
        <div class="flex items-center justify-between pb-3 mb-3 border-b border-brand-dark/5">
          <span class="text-xs font-semibold uppercase tracking-wider text-brand-dark flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-brand-accent animate-pulse"></span>
            Em Rota GPS (<%= kanban.in_transit.length %>)
          </span>
          <span class="text-[9px] uppercase tracking-wider text-brand-accent font-mono">Fase 3</span>
        </div>

        <div class="space-y-3 flex-grow overflow-y-auto max-h-[500px]">
          <% if (kanban.in_transit.length === 0) { %>
            <p class="text-xs text-stone-400 text-center py-8 font-light">Nenhum estafeta em trânsito.</p>
          <% } %>
          <% kanban.in_transit.forEach(order => { %>
            <div class="bg-brand-surfaceSoft rounded-lg p-3.5 border border-brand-accent/40 text-xs">
              <div class="flex justify-between items-start">
                <span class="font-mono text-[11px] font-bold text-brand-accent">#<%= order.id %></span>
                <a href="/rastreio/<%= order.id %>" target="_blank" class="text-[10px] font-medium text-brand-accent hover:underline">
                  Ver Mapa &rarr;
                </a>
              </div>
              <h4 class="font-medium text-brand-dark mt-1"><%= order.customerName %></h4>
              <p class="text-[11px] text-brand-muted"><%= order.neighborhood %> (<%= order.deliveryAddress %>)</p>
              <p class="text-[10px] text-stone-400 mt-1"><%= order.customerPhone %></p>

              <div class="mt-3 pt-2 border-t border-brand-dark/5 flex items-center justify-between">
                <span class="font-serif text-xs text-brand-dark"><%= order.total %> MZN</span>
                <button onclick="window.Admin.updateStatus('<%= order.id %>', 'delivered')" class="px-2.5 py-1 rounded bg-emerald-700 hover:bg-emerald-800 text-white text-[10px] uppercase tracking-wider transition-colors">
                  Concluir
                </button>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Coluna: 4. Entregues -->
      <div class="bg-brand-surface rounded-xl p-4 border border-brand-dark/10 flex flex-col">
        <div class="flex items-center justify-between pb-3 mb-3 border-b border-brand-dark/5">
          <span class="text-xs font-semibold uppercase tracking-wider text-brand-dark flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
            Entregues (<%= kanban.delivered.length %>)
          </span>
          <span class="text-[9px] uppercase tracking-wider text-stone-500 font-mono">Concluído</span>
        </div>

        <div class="space-y-3 flex-grow overflow-y-auto max-h-[500px]">
          <% if (kanban.delivered.length === 0) { %>
            <p class="text-xs text-stone-400 text-center py-8 font-light">Sem encomendas concluídas hoje.</p>
          <% } %>
          <% kanban.delivered.forEach(order => { %>
            <div class="bg-brand-surfaceSoft rounded-lg p-3.5 border border-brand-dark/5 text-xs opacity-75">
              <div class="flex justify-between items-start">
                <span class="font-mono text-[11px] text-stone-500">#<%= order.id %></span>
                <span class="text-[10px] text-emerald-700 font-medium">Entregue</span>
              </div>
              <h4 class="font-medium text-brand-dark mt-1"><%= order.customerName %></h4>
              <p class="text-[11px] text-stone-400"><%= order.neighborhood %></p>
              <div class="mt-2 text-xs font-serif text-brand-dark">
                <%= order.total %> MZN • <span class="uppercase text-[9px] font-sans text-stone-500"><%= order.paymentMethod %></span>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

    </div>
  </section>

  <!-- Seção 2: Gestão de Carta & Stock -->
  <section class="pt-8 border-t border-brand-dark/10">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
      <div>
        <h2 class="font-serif text-2xl font-normal text-brand-dark">Catálogo & Disponibilidade da Carta</h2>
        <p class="text-xs text-brand-muted font-light">Controle em tempo real da disponibilidade de cada receita no site de Pemba.</p>
      </div>

      <button id="openNewProductModalBtn" class="btn-editorial px-4 py-2.5 rounded-lg bg-brand-dark hover:bg-brand-accent text-brand-bg text-xs font-medium uppercase tracking-wider transition-colors flex items-center gap-2">
        <i class="fa-solid fa-plus text-[10px]"></i>
        <span>Adicionar Produto à Carta</span>
      </button>
    </div>

    <!-- Tabela de Produtos -->
    <div class="bg-brand-surface rounded-xl border border-brand-dark/10 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-brand-surfaceSoft border-b border-brand-dark/10 text-stone-500 font-medium uppercase tracking-wider text-[10px]">
              <th class="p-3.5">Item da Carta</th>
              <th class="p-3.5">Categoria</th>
              <th class="p-3.5">Preço (MZN)</th>
              <th class="p-3.5">Disponibilidade</th>
              <th class="p-3.5 text-right">Ação</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-brand-dark/5">
            <% products.forEach(prod => { %>
              <tr class="hover:bg-brand-surfaceSoft/60 transition-colors">
                <td class="p-3.5 flex items-center gap-3">
                  <img src="<%= prod.imageUrl || prod.image %>" alt="<%= prod.name %>" class="w-9 h-9 rounded-md object-cover bg-stone-100 flex-shrink-0">
                  <div>
                    <span class="font-medium text-brand-dark block"><%= prod.name %></span>
                    <span class="text-[10px] text-stone-400 line-clamp-1 font-light"><%= prod.description %></span>
                  </div>
                </td>
                <td class="p-3.5">
                  <span class="px-2 py-0.5 rounded bg-stone-100 text-stone-600 text-[10px] uppercase font-mono">
                    <%= prod.category %>
                  </span>
                </td>
                <td class="p-3.5 font-serif text-brand-dark text-sm">
                  <%= prod.price %> MZN
                </td>
                <td class="p-3.5">
                  <button 
                    onclick="window.Admin.toggleAvailability('<%= prod.id %>')"
                    class="px-2.5 py-1 rounded-md text-[10px] font-medium uppercase tracking-wider transition-all <%= prod.isAvailable ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-red-50 text-red-800 border border-red-200' %>">
                    <%= prod.isAvailable ? 'Disponível' : 'Esgotado' %>
                  </button>
                </td>
                <td class="p-3.5 text-right">
                  <button 
                    onclick="window.Admin.deleteProduct('<%= prod.id %>')" 
                    class="p-1.5 text-stone-400 hover:text-red-700 transition-colors rounded" 
                    title="Remover Item">
                    <i class="fa-solid fa-trash-can text-xs"></i>
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </section>

</div>

<!-- Modal Adicionar Novo Produto -->
<div id="newProductModal" class="fixed inset-0 z-50 flex items-center justify-center bg-brand-dark/50 backdrop-blur-sm p-4 hidden opacity-0 transition-opacity">
  <div class="bg-brand-surface rounded-2xl max-w-lg w-full p-6 sm:p-8 shadow-2xl relative border border-brand-dark/10">
    <button id="closeNewProductModalBtn" class="absolute top-5 right-5 text-stone-400 hover:text-brand-dark">
      <i class="fa-solid fa-xmark text-sm"></i>
    </button>
    
    <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-brand-muted block mb-1">Novo Item</span>
    <h3 class="font-serif text-2xl font-normal text-brand-dark mb-4">Adicionar à Carta de Pemba</h3>

    <form id="newProductForm" class="space-y-4">
      <div>
        <label class="block text-[11px] font-semibold uppercase text-brand-dark mb-1">Designação da Receita *</label>
        <input type="text" name="name" required placeholder="Ex: Tarte Tatin de Maçã Caramelizada" class="w-full px-3.5 py-2.5 rounded-lg border border-brand-dark/15 text-xs bg-brand-bg">
      </div>

      <div class="grid grid-cols-2 gap-3.5">
        <div>
          <label class="block text-[11px] font-semibold uppercase text-brand-dark mb-1">Preço em MZN *</label>
          <input type="number" name="price" required placeholder="Ex: 320" class="w-full px-3.5 py-2.5 rounded-lg border border-brand-dark/15 text-xs bg-brand-bg">
        </div>
        <div>
          <label class="block text-[11px] font-semibold uppercase text-brand-dark mb-1">Categoria *</label>
          <select name="category" required class="w-full px-3.5 py-2.5 rounded-lg border border-brand-dark/15 text-xs bg-brand-bg">
            <option value="paes">Pães Artesanais</option>
            <option value="bolos">Bolos & Tortas</option>
            <option value="pastelaria">Pastelaria Fina</option>
            <option value="gelados">Gelataria de Autor</option>
            <option value="refeicoes">Refeições & Brunch</option>
            <option value="bebidas">Cafetaria & Bebidas</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-[11px] font-semibold uppercase text-brand-dark mb-1">URL da Imagem</label>
        <input type="url" name="imageUrl" placeholder="https://images.unsplash.com/..." class="w-full px-3.5 py-2.5 rounded-lg border border-brand-dark/15 text-xs bg-brand-bg">
      </div>

      <div>
        <label class="block text-[11px] font-semibold uppercase text-brand-dark mb-1">Descrição Gastronômica</label>
        <textarea name="description" rows="2" placeholder="Detalhes dos ingredientes nobres e modo de preparo..." class="w-full px-3.5 py-2.5 rounded-lg border border-brand-dark/15 text-xs bg-brand-bg"></textarea>
      </div>

      <div class="flex items-center gap-2">
        <input type="checkbox" name="isFeatured" id="featuredCheck" class="rounded text-brand-dark focus:ring-brand-dark">
        <label for="featuredCheck" class="text-xs text-brand-dark font-normal cursor-pointer">Incluir na Seleção em Destaque da Página Inicial</label>
      </div>

      <button type="submit" class="btn-editorial w-full py-3.5 rounded-lg bg-brand-dark hover:bg-brand-accent text-brand-bg font-medium text-xs uppercase tracking-wider transition-colors shadow-sm mt-2">
        Registar na Carta Oficial
      </button>
    </form>
  </div>
</div>

<script src="/js/admin.js"></script>

<%- include('partials/footer') %>
