<script>
  window.updateHeroDeliveryEstimate = function(val) {
    const [fee, eta] = val.split('|');
    const el = document.getElementById('heroDeliveryResult');
    if (el) {
      el.textContent = Number(fee) === 0 ? `Grátis · Pronto em ~${eta}` : `Taxa: ${fee} MZN · ~${eta}`;
    }
  };

  window.filterHomeCategory = function(catId, btnEl) {
    document.querySelectorAll('[role="tablist"] .category-pill').forEach(p => p.classList.remove('active'));
    btnEl.classList.add('active');

    const cards = document.querySelectorAll('#homeProductsGrid article[data-cat]');
    cards.forEach(card => {
      const cardCat = card.getAttribute('data-cat');
      if (catId === 'todos' || cardCat === catId) {
        card.style.display = '';
      } else {
        card.style.display = 'none';
      }
    });
  };
</script>

